# Copy to secrets.toml and fill in. secrets.toml is gitignored and must stay
# that way — it holds the API key and, if you use one, the board password.
#
# Everything here is optional. With none of it set the app runs exactly as it
# always has: open, local, real data, no bot.

# --- The Finance Bot -------------------------------------------------------
GEMINI_API_KEY = "your-key-here"
# GEMINI_MODEL = "gemini-3.5-flash-lite"   # optional, overrides the default


# The file keeps its old home under .streamlit/ so an existing install carries
# straight over; nothing else in the app uses Streamlit any more. Environment
# variables of the same names work too, and the file wins where both are set.

# --- Which instance is this? ----------------------------------------------
# Set to "1" ONLY on a public sample deployment. It makes the app
# generate its own sample records on an empty database and label them, so the
# public link always shows a full board and never shows real finances.
#
# It does not put sample rows on top of real ones, and it does not remove the
# password gate unless what is actually in the database is generated data.
# LOOT_LEDGER_DEMO = "1"


# --- Standing in front of the real ledger ---------------------------------
# Only needed once the laptop instance is reachable from outside — a Tailscale
# or Cloudflare tunnel, so the phone can use it. On a laptop that nothing can
# reach, leave it unset.
#
# LOOT_LEDGER_PASSWORD = "something-long-and-not-guessable"

# The [auth] block below was the Streamlit app's Google sign-in (st.login()).
# It is NOT supported since the move to FastAPI: if it is present, the board
# uses LOOT_LEDGER_PASSWORD when that is set, and stays locked otherwise. Set
# a password rather than relying on this block.
#
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "a-long-random-string-you-invent"
# [auth.google]
# client_id = "....apps.googleusercontent.com"
# client_secret = "...."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
